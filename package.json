{
  "name": "queuecare",
  "version": "0.1.0",
  "private": true,
  "description": "Live clinic queue: urgent patients first, fair for everyone else, estimated wait on every phone",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "next build && playwright test",
    "typecheck": "tsc --noEmit",
    "check:security": "node --experimental-websocket scripts/check-security.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.12"
  }
}
